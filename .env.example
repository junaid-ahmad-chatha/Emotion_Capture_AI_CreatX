# Copy this file to .env and fill in your real local values.
# Do not commit real API keys. This file is only a safe template.

# Optional: used for reflections, advice, and insights.
GEMINI_API_KEY=

# Required for the MindfulMirror chatbot.
# Create a key at https://openrouter.ai/settings/keys and paste it in .env only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=MindfulMirror
